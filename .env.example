# Database
DB_PASSWORD=chamados_secret_2024

# Backend
SECRET_KEY=chamados-super-secret-key-change-in-production-32chars
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30
DATABASE_URL=postgresql+asyncpg://chamados_user:chamados_secret_2024@postgres:5432/chamados_db
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173

# Google OAuth
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_ALLOWED_DOMAIN=grupofedcorp.com.br

# Bank de dados inicial (usuarios/setores de demonstracao)
SEED_ENABLED=true

# Email
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=chamados@empresa.com
SMTP_PASS=your-app-password
EMAIL_FROM=Chamados TI <chamados@empresa.com>

# SuporteBot (assistente de TI com Claude). Dois jeitos de ligar:
#  (A) API da Anthropic por token: preencha ANTHROPIC_API_KEY (platform.claude.com > API Keys).
#  (B) Assinatura Claude do Grupo via conteiner chamados-claude (mesmo padrao do fedhub-claude):
#      copie o .credentials.json da conta do chatbot para ./claude_home/ e suba o compose;
#      o docker-compose ja injeta CLAUDE_URL=http://chamados-claude:8788 no backend.
# BOT_PROVIDER=auto usa a API se houver chave, senao o CLI se houver CLAUDE_URL.
BOT_PROVIDER=auto
ANTHROPIC_API_KEY=
BOT_MODEL=claude-opus-5-5
BOT_EFFORT=medium
BOT_MAX_HISTORY=40
BOT_FALLBACKS=true
BOT_CLI_MODEL=
BOT_CLI_TIMEOUT=120
BOT_CLI_CONCURRENCY=3
#  (D) PC que ja tem o Claude Code instalado e logado (rodando o backend direto nele, sem Docker):
#      nada a configurar; o backend acha o claude.exe sozinho. Se precisar, CLAUDE_BIN=<caminho do claude.exe>.
#  (C) Reaproveitar o fedhub-claude que ja roda no host do FedHub (192.168.0.100): publique a porta
#      8788 la (ver README) e aponte CLAUDE_URL para ele. CLAUDE_TOKEN protege a porta (X-Claude-Token).
# CLAUDE_URL=http://192.168.0.100:8788
CLAUDE_TOKEN=

# Frontend
# Copie estas variaveis para frontend/.env (a Vite so le o .env do proprio diretorio)
VITE_API_URL=http://localhost:8000/api
VITE_BASE_PATH=/
VITE_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
